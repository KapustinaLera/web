@startuml Lab5_XML_RSS
skinparam classAttributeIconSize 0

' === Интерфейс БД ===
interface INewsDB {
  +saveNews(title, category, description, source): boolean
  +getNews(): array
  +deleteNews(id): boolean
}

' === Главный класс NewsDB ===
class NewsDB {
  {static} DB_NAME: string = "news.db"
  {static} RSS_NAME: string = "rss.xml"
  {static} RSS_TITLE: string = "Последние новости"
  {static} RSS_LINK: string = "http://site.ru/news.php"
  -_db: SQLite3
  -items: array = []
  +__construct()
  +__destruct()
  +saveNews(title, category, description, source): boolean
  +getNews(): array
  +deleteNews(id): boolean
  -getCategories(): array
  +createRss(): void
  #getDb(): SQLite3
}

' === Класс БД ===
class SQLite3 {
  +query(sql): SQLite3Result
  +exec(sql): bool
  +prepare(sql): SQLite3Stmt
  +close(): bool
}

' === Итератор для категорий (остался из 4-й лабы) ===
class ArrayIterator

' === DOM-классы (новое в 5-й лабе для RSS) ===
class DOMDocument {
  +formatOutput: bool
  +preserveWhiteSpace: bool
  +createElement(name, value): DOMElement
  +createAttribute(name): DOMAttr
  +createCDATASection(data): DOMCdataSection
  +appendChild(node): DOMNode
  +save(filename): bool
}

class DOMElement {
  +appendChild(node): DOMNode
}

class DOMAttr {
  +value: string
}

class DOMCdataSection

' === Связи ===
INewsDB <|.. NewsDB : implements
NewsDB --> SQLite3 : uses

' Создание итератора для категорий
NewsDB ..> ArrayIterator : creates

' Создание RSS через DOM
NewsDB ..> DOMDocument : creates in createRss()
DOMDocument o--> DOMElement : creates
DOMDocument o--> DOMAttr : creates
DOMDocument o--> DOMCdataSection : creates

@enduml
