@startuml Lab5_XML_DOM
skinparam classAttributeIconSize 0
left to right direction

interface INewsDB {
  +saveNews(title, category, description, source): boolean
  +getNews(): array
  +deleteNews(id): boolean
}

interface IteratorAggregate {
  +getIterator(): Traversable
}

interface Iterator {
  +rewind(): void
  +valid(): bool
  +next(): void
  +key(): mixed
  +current(): mixed
}

class NewsDB {
  {static} DB_NAME: string = "news.db"
  {static} RSS_NAME: string = "rss.xml"
  {static} RSS_TITLE: string = "Последние новости"
  {static} RSS_LINK: string = "http://.../news.php"
  -_db: SQLite3
  -items: array = []
  +__construct()
  +__destruct()
  +saveNews(title, category, description, source): boolean
  +getNews(): array
  +deleteNews(id): boolean
  -getCategories(): void
  +getIterator(): Traversable
  +createRss(): void
  #getDb(): SQLite3
}

class SQLite3 {
  +query(sql): SQLite3Result
  +exec(sql): bool
  +prepare(sql): SQLite3Stmt
  +close(): bool
}

class ArrayIterator

class NumbersSquared {
  -start: int
  -end: int
  -current: int
  +__construct(start, end)
  +rewind(): void
  +valid(): bool
  +next(): void
  +key(): mixed
  +current(): mixed
}



class DOMDocument {
  +formatOutput: bool
  +preserveWhiteSpace: bool
  +createElement(name, value): DOMElement
  +createAttribute(name): DOMAttr
  +createCDATASection(data): DOMCdataSection
  +appendChild(node): DOMNode
  +save(filename): bool
}

class DOMElement {
  +appendChild(node): DOMNode
}

class DOMAttr {
  +value: string
}

class DOMCdataSection

class DOMText

INewsDB <|.. NewsDB : implements
IteratorAggregate <|.. NewsDB : implements

NewsDB --> SQLite3 : uses

NewsDB ..> ArrayIterator : creates in getIterator()
ArrayIterator ..|> Iterator : implements

Iterator <|.. NumbersSquared : implements

NewsDB ..> DOMDocument : creates in createRss()

DOMDocument o--> DOMElement : creates
DOMDocument o--> DOMAttr : creates
DOMDocument o--> DOMCdataSection : creates
DOMDocument o--> DOMText : creates

@enduml
