@startuml
interface INewsDB {
  +saveNews(title, category, description, source): boolean
  +getNews(): array
  +deleteNews(id): boolean
}

interface IteratorAggregate {
  +getIterator(): Traversable
}

class NewsDB {
  {static} DB_NAME: string = "news.db"
  -_db: SQLite3
  -items: array = []
  +__construct()
  +__destruct()
  +saveNews(title, category, description, source): boolean
  +getNews(): array
  +deleteNews(id): boolean
  -getCategories(): void
  +getIterator(): Traversable
  #getDb(): SQLite3
}

class SQLite3 {
  +query(sql): SQLite3Result
  +exec(sql): bool
  +prepare(sql): SQLite3Stmt
  +close(): bool
}

class ArrayIterator

INewsDB <|.. NewsDB
IteratorAggregate <|.. NewsDB
NewsDB --> SQLite3 : uses
NewsDB ..> ArrayIterator : creates
@enduml
