@startuml Lab6_PDO
skinparam classAttributeIconSize 0
left to right direction

interface INewsDB {
  +saveNews(title, category, description, source): boolean
  +getNews(): array
  +deleteNews(id): boolean
}

interface IteratorAggregate {
  +getIterator(): Traversable
}

class NewsDB {
  {static} DB_NAME: string = "news.db"
  {static} RSS_NAME: string = "rss.xml"
  {static} RSS_TITLE: string = "Последние новости"
  {static} RSS_LINK: string = "http://site.ru/news.php"
  
  -_db: PDO
  -items: array = []
  
  +__construct()
  +__destruct()
  +saveNews(title, category, description, source): boolean
  +getNews(): array
  +deleteNews(id): boolean
  -getCategories(): array
  +getIterator(): Traversable
  +createRss(): void
  #getDb(): PDO
}

class PDO {
  +__construct(dsn, user, pass, options)
  +exec(sql): int
  +query(sql): PDOStatement
  +quote(string): string
  +beginTransaction(): bool
  +commit(): bool
  +rollBack(): bool
  +inTransaction(): bool
  +setAttribute(attr, value): bool
  +errorCode(): string
  +errorInfo(): array
}

class PDOStatement {
  +fetchAll(mode): array
  +fetch(mode): array
  +closeCursor(): bool
}

class PDOException {
  +getCode(): int
  +getMessage(): string
}

class DOMDocument {
  +formatOutput: bool
  +preserveWhiteSpace: bool
  +createElement(name, value): DOMElement
  +createAttribute(name): DOMAttr
  +createCDATASection(data): DOMCdataSection
  +appendChild(node): DOMNode
  +save(filename): bool
}

class DOMElement {
  +appendChild(node): DOMNode
}

class DOMAttr {
  +value: string
}

class DOMCdataSection

class ArrayIterator

' Реализация интерфейсов
INewsDB <|.. NewsDB : implements
IteratorAggregate <|.. NewsDB : implements

NewsDB --> PDO : uses
PDO ..> PDOStatement : creates
PDO ..> PDOException : throws on error

' Транзакции в конструкторе
NewsDB ..> PDO : beginTransaction/commit/rollBack

' Итераторы
NewsDB ..> ArrayIterator : creates in getIterator()

' RSS через DOM (из 5-й лабы)
NewsDB ..> DOMDocument : creates in createRss()
DOMDocument o--> DOMElement : creates
DOMDocument o--> DOMAttr : creates
DOMDocument o--> DOMCdataSection : creates

@enduml
