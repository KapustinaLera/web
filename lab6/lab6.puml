@startuml Lab6_PDO
skinparam classAttributeIconSize 0

interface INewsDB {
  +saveNews(title, category, description, source): boolean
  +getNews(): array
  +deleteNews(id): boolean
}

class NewsDB {
  {static} DB_NAME: string = "news.db"
  {static} RSS_NAME: string = "rss.xml"
  {static} RSS_TITLE: string = "Последние новости"
  {static} RSS_LINK: string = "http://site.ru/news.php"
  -_db: PDO
  -items: array = []
  +__construct()
  +__destruct()
  +saveNews(title, category, description, source): boolean
  +getNews(): array
  +deleteNews(id): boolean
  -getCategories(): array
  +createRss(): void
  #getDb(): PDO
}

class PDO {
  +__construct(dsn, user, pass, options)
  +exec(sql): int
  +query(sql): PDOStatement
  +quote(string): string
  +beginTransaction(): bool
  +commit(): bool
  +rollBack(): bool
  +inTransaction(): bool
  +errorCode(): string
  +errorInfo(): array
}

class PDOStatement {
  +fetchAll(mode): array
  +fetch(mode): array
  +closeCursor(): bool
}

class PDOException {
  +getCode(): int
  +getMessage(): string
}

class ArrayIterator

class DOMDocument {
  +formatOutput: bool
  +preserveWhiteSpace: bool
  +createElement(name, value): DOMElement
  +createAttribute(name): DOMAttr
  +createCDATASection(data): DOMCdataSection
  +appendChild(node): DOMNode
  +save(filename): bool
}

class DOMElement {
  +appendChild(node): DOMNode
}

class DOMAttr {
  +value: string
}

class DOMCdataSection

INewsDB <|.. NewsDB : implements

' NewsDB использует PDO вместо SQLite3
NewsDB --> PDO : uses
PDO ..> PDOStatement : creates

' Создание итератора для категорий
NewsDB ..> ArrayIterator : creates

' Создание RSS через DOM
NewsDB ..> DOMDocument : creates in createRss()
DOMDocument ..> DOMElement : creates
DOMDocument ..> DOMAttr : creates
DOMDocument ..> DOMCdataSection : creates

@enduml
