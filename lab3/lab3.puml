@startuml
interface INewsDB {
  +saveNews(title, category, description, source): boolean
  +getNews(): array
  +deleteNews(id): boolean
}

class NewsDB {
  {static} DB_NAME: string = "news.db"
  -_db: SQLite3
  +__construct()
  +__destruct()
  +saveNews(title, category, description, source): boolean
  +getNews(): array
  +deleteNews(id): boolean
  #getDb(): SQLite3
}

class SQLite3 {
  +query(sql): SQLite3Result
  +exec(sql): bool
  +prepare(sql): SQLite3Stmt
  +close(): bool
}

INewsDB <|.. NewsDB
NewsDB --> SQLite3
@enduml
